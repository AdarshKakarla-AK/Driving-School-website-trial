# Sri Mathru Driving School — Caddy reverse proxy with automatic HTTPS.
# Replace your-domain.example.com with your real domain (Caddy needs a DNS
# record pointing at the server and ports 80/443 open).
#
# Put this file at /etc/caddy/Caddyfile and run:
#   sudo systemctl reload caddy

your-domain.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000 {
		# Preserve the real scheme/port for absolute links generated by the app.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	# Optional: basic uptime/monitoring endpoint through TLS
	handle /api/health {
		reverse_proxy 127.0.0.1:3000
	}
}
